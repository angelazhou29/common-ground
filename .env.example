NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OWNER_EMAIL=
# Configure only for the authenticated hourly maintenance workflow.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_USER_ID=
# Must remain false until separately verified and approved.
LIVE_SENDING_ENABLED=false

# Optional login-free loopback access on this computer; disabled on Vercel.
# Requires existing OWNER_USER_ID and server-only service role key.
LOCAL_OWNER_MODE=false

# Enable ONLY after Vercel Authentication is set to ALL deployments.
# No protection exceptions or public share/bypass links.
VERCEL_PROTECTED_OWNER_MODE=false

# Daily discovery only; never sends or prepares email.
# Also configure the GitHub Actions runner and workspace discovery preference.
DISCOVERY_ENABLED=false
BRAVE_SEARCH_API_KEY=
# Exact hosts whose published terms permit this research; no hosts by default.
DISCOVERY_ALLOWED_HOSTS=
# Public HTTPS page identifying the bot operator and a contact method.
DISCOVERY_CONTACT_URL=
# Fixed in code: 50 contacts/day, 3 per target firm plus one extra slot at five
# rotating firms. Off-list companies and non-Sales-and-Trading roles are rejected.
DISCOVERY_MAX_SEARCHES=120
DISCOVERY_MAX_PAGES=200
